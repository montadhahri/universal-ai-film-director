{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal AI Film Director Project Bible snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "phase",
    "gates",
    "decisions",
    "continuity",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "discovery",
        "script",
        "visual_bible",
        "storyboard",
        "sound",
        "generator",
        "generate",
        "review",
        "delivery"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "visual_bible",
        "storyboard"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/gate"
        },
        "visual_bible": {
          "$ref": "#/$defs/gate"
        },
        "storyboard": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "continuity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint_note": {
      "type": "string"
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "status",
        "value",
        "source",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PROPOSED",
            "APPROVED"
          ]
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "character",
            "location",
            "style",
            "timeline",
            "audio",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PROPOSED",
            "APPROVED",
            "LOCKED"
          ]
        },
        "asset_ref": {
          "type": "string"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "state",
        "continuity_refs",
        "issues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parent_revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "DRAFT",
            "PROPOSED",
            "APPROVED",
            "LOCKED",
            "NEEDS_FIX"
          ]
        },
        "approved_asset": {
          "type": "string"
        },
        "continuity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
