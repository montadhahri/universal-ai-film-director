{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable read-only project snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_schema_version",
    "project_id",
    "revision",
    "phase",
    "gates",
    "shots",
    "memory_anchors",
    "authorization",
    "workflow"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "source_schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gate"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "memory_anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_go",
        "provider_job_allowed",
        "publication_allowed"
      ],
      "properties": {
        "production_go": {
          "const": false
        },
        "provider_job_allowed": {
          "const": false
        },
        "publication_allowed": {
          "const": false
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_count",
        "pending_gate_proposal_count",
        "locked_shot_count"
      ],
      "properties": {
        "proposal_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_gate_proposal_count": {
          "type": "integer",
          "minimum": 0
        },
        "locked_shot_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "state",
        "continuity_refs",
        "issues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "DRAFT",
            "PROPOSED",
            "APPROVED",
            "LOCKED",
            "NEEDS_FIX"
          ]
        },
        "approved_asset": {
          "type": "string",
          "minLength": 1
        },
        "continuity_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "revision",
        "status",
        "shot_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "character",
            "wardrobe",
            "prop",
            "location",
            "look"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "PROPOSED",
            "APPROVED",
            "UNKNOWN"
          ]
        },
        "shot_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
