{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community showcase submission metadata v1 (not publication authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "title",
    "summary",
    "creator_display_name",
    "skills_used",
    "assets",
    "rights_review",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "creator_display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "skills_used": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "universal-ai-film-director",
          "film-storytelling",
          "film-visual-direction",
          "film-cinematography",
          "film-video-production",
          "film-sound-direction",
          "film-continuity-qa"
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_refs",
        "reviewer_decision"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_VERIFIED",
            "IN_REVIEW",
            "VERIFIED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewer_decision": {
          "enum": [
            "HOLD",
            "APPROVED_FOR_SUBMISSION"
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_consent",
        "platform_permission",
        "status"
      ],
      "properties": {
        "owner_consent": {
          "type": "boolean"
        },
        "platform_permission": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "DRAFT",
            "READY_FOR_REVIEW",
            "PUBLISHED"
          ]
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "origin",
        "rights_status",
        "evidence_refs"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "text",
            "other"
          ]
        },
        "origin": {
          "enum": [
            "CREATOR_ORIGINAL",
            "AI_GENERATED",
            "THIRD_PARTY",
            "UNKNOWN"
          ]
        },
        "rights_status": {
          "enum": [
            "NOT_VERIFIED",
            "VERIFIED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
