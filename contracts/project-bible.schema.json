{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Bible current contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "phase",
    "gates",
    "decisions",
    "continuity",
    "shots",
    "proposals",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "discovery",
        "script",
        "visual_bible",
        "storyboard",
        "sound",
        "generator",
        "generate",
        "review",
        "delivery"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "visual_bible",
        "storyboard"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/gate"
        },
        "visual_bible": {
          "$ref": "#/$defs/gate"
        },
        "storyboard": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "continuity": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "handoff.schema.json"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_go",
        "provider_job_allowed",
        "publication_allowed"
      ],
      "properties": {
        "production_go": {
          "const": false
        },
        "provider_job_allowed": {
          "const": false
        },
        "publication_allowed": {
          "const": false
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "gate",
          "version",
          "artifact_ref",
          "status",
          "created_revision"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "enum": [
              "script",
              "visual_bible",
              "storyboard"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PENDING",
              "APPROVED"
            ]
          },
          "created_revision": {
            "type": "integer",
            "minimum": 1
          },
          "approved_evidence": {
            "$ref": "#/$defs/userEvidence"
          }
        }
      }
    },
    "approval_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "gate",
          "proposal_id",
          "version",
          "artifact_ref",
          "evidence"
        ],
        "properties": {
          "kind": {
            "const": "GATE"
          },
          "gate": {
            "enum": [
              "script",
              "visual_bible",
              "storyboard"
            ]
          },
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/userEvidence"
          }
        }
      }
    },
    "unlock_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorization_ref",
          "shot_id",
          "source_revision",
          "new_revision",
          "reason",
          "evidence"
        ],
        "properties": {
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "new_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/userEvidence"
          }
        }
      }
    },
    "permission_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "permission",
          "scope",
          "evidence",
          "status"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1
          },
          "permission": {
            "enum": [
              "production_go",
              "provider_job",
              "publication"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/userEvidence"
          },
          "status": {
            "const": "RECORDED_ONLY"
          }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approved": {
                "const": true
              }
            },
            "required": [
              "approved"
            ]
          },
          "then": {
            "required": [
              "version",
              "evidence"
            ]
          }
        }
      ]
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "state",
        "continuity_refs",
        "issues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parent_revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "DRAFT",
            "PROPOSED",
            "APPROVED",
            "LOCKED",
            "NEEDS_FIX"
          ]
        },
        "approved_asset": {
          "type": "string",
          "minLength": 1
        },
        "continuity_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "LOCKED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "approved_asset"
            ]
          }
        }
      ]
    },
    "userEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "source_ref",
        "quote"
      ],
      "properties": {
        "actor": {
          "const": "USER"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
